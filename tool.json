{
  "id": "campcalendar",
  "title": "Camp Calendar",
  "description": "Compare how far ahead campers booked at Nova Scotia provincial parks, two parks at a time.",
  "category": "places",
  "tags": [
    "Nova Scotia",
    "parks",
    "camping",
    "reservations",
    "tent",
    "RV"
  ],
  "icon": "map",
  "url": "/campcalendar/",
  "source": "https://github.com/jsdyer/campcalendar",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "Overnight reservations from Nova Scotia’s provincial parks show how far ahead campers booked their trips.",
    "cadence": "Monthly",
    "probes": [
      {
        "label": "Data retrieved",
        "url": "https://coolcode.ca/campcalendar/data/status.json",
        "path": [
          "retrieved"
        ],
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "reservations"
        }
      },
      {
        "label": "Arrival years",
        "url": "https://coolcode.ca/campcalendar/data/status.json",
        "path": [
          "years",
          0
        ],
        "end_path": [
          "years",
          -1
        ]
      }
    ]
  }
}
